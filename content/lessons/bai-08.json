  "grammar": [
    {
      "id": "g-bai-08-classifiers",
      "title": "Klasyfikatory",
      "pattern": "liczebnik + klasyfikator + rzeczownik",
      "explanation": "Klasyfikatory to słowa stojące przed rzeczownikiem, które grupują rzeczowniki według podobnych cech. Używa się ich przy określaniu ilości i położenia rzeczownika.\n\nNajbardziej uniwersalne: „cái” – rzeczy nieżywe (ba cái nhà), „con” – zwierzęta i istoty żywe oprócz ludzi (năm con chó), „người” – ludzie (chín người bác sĩ). Naczynia też działają jak klasyfikatory: „ly” (szklanka), „cốc” (kubek), „chén” (miseczka): một ly cà phê, một chén cơm.",
      "examples": [
        { "vi": "ba cái nhà", "pl": "trzy domy" },
        { "vi": "hai con mèo", "pl": "dwa koty" },
        { "vi": "chín người bác sĩ", "pl": "dziewięciu lekarzy" },
        { "vi": "một chén cơm", "pl": "miseczka ryżu" },
        { "vi": "hai ly cà phê", "pl": "dwie kawy" }
      ],
      "keywords": ["klasyfikator", "cái", "con", "người", "ly", "cốc", "chén"],
      "practice": ["e-bai-08-classifier-gen", "e-bai-08-mcq-classifier", "e-bai-08-fill-classifier"]
    },
    {
      "id": "g-bai-08-ordering",
      "title": "Zamawianie: cho + zaimek + ilość",
      "pattern": "Cho + zaimek (ja) + liczebnik + klasyfikator + potrawa · Zaimek + ơi! · Tính tiền!",
      "explanation": "Zamówienie zaczyna się od „cho” + zaimek, którym mówimy o sobie (anh / chị / em …): „Cho anh một ly cà phê” = poproszę jedną kawę. Kelnera woła się przez zaimek + „ơi!”. Rachunek: „Tính tiền!”. Kelner pyta „Anh muốn uống gì?” (co chce pan pić?), a gość może zapytać „Có đồ uống gì?” (jakie są napoje?).",
      "examples": [
        { "vi": "Cho anh năm cái nem rán, một chén cơm và hai cái bánh xèo.", "pl": "Poproszę pięć sajgonek, miseczkę ryżu i dwa bánh xèo." },
        { "vi": "Có đồ uống gì?", "pl": "Jakie są napoje?" },
        { "vi": "Em ơi! Tính tiền!", "pl": "Przepraszam! Rachunek!" }
      ],
      "keywords": ["cho", "ơi", "tính tiền", "zamawianie", "restauracja"],
      "practice": ["e-bai-08-order-coffee", "e-bai-08-typed-bill", "e-bai-08-dialogue-1", "e-bai-08-dialogue-2"]
    }
  ],
  "dialogues": [
    {
      "id": "d-bai-08-restaurant",
      "title": "Ở quán ăn",
      "situation": "Phi zamawia w restauracji; kelner (người phục vụ, NPV) jest młodszy, więc mówi „em” o sobie i „anh” do gościa.",
      "lines": [
        { "speaker": "Người phục vụ", "vi": "Em chào anh! Đây là thực đơn cho anh xem.", "pl": "Dzień dobry! Oto menu do obejrzenia." },
        { "speaker": "Phi", "vi": "Chào em, cảm ơn. Cho anh năm cái nem rán, một chén cơm và hai cái bánh xèo.", "pl": "Dzień dobry, dziękuję. Poproszę pięć sajgonek, miseczkę ryżu i dwa bánh xèo." },
        { "speaker": "Người phục vụ", "vi": "Anh muốn uống gì?", "pl": "Co chce pan pić?" },
        { "speaker": "Phi", "vi": "Có đồ uống gì?", "pl": "Jakie są napoje?" },
        { "speaker": "Người phục vụ", "vi": "Có cà phê muối, cà phê trứng, cà phê sữa đá, trà xanh, trà sữa và nước.", "pl": "Jest kawa solona, kawa jajeczna, mrożona kawa z mlekiem, zielona herbata, herbata z mlekiem i woda." },
        { "speaker": "Phi", "vi": "Thế thì cho anh một ly cà phê trứng. Cảm ơn em.", "pl": "W takim razie poproszę jedną kawę jajeczną. Dziękuję." },
        { "speaker": "Người phục vụ", "vi": "Đồ ăn cho anh và một ly cà phê.", "pl": "Jedzenie dla pana i jedna kawa." },
        { "speaker": "Phi", "vi": "Em ơi! Tính tiền!", "pl": "(po jedzeniu) Przepraszam! Rachunek!" },
        { "speaker": "Người phục vụ", "vi": "Vâng, 150 000 đồng.", "pl": "Tak, 150 000 dongów.", "note": "W oryginale „Văng” – CONFIRMED TYPO, poprawiono na „Vâng”." },
        { "speaker": "Phi", "vi": "Mắt tiền cho em.", "pl": "Gotówka dla ciebie (płacę gotówką).", "status": "flagged", "note": "CONTENT_REVIEW: standardowo „tiền mặt”." },
        { "speaker": "Người phục vụ", "vi": "Cảm ơn anh, chào anh!", "pl": "Dziękuję, do widzenia!" }
      ]
    }
  ],
