        { "speaker": "A", "vi": "Anh là người Mỹ. Còn em?", "pl": "Jestem Amerykaninem. A ty?" },
        { "speaker": "B", "vi": "Em là người Việt Nam.", "pl": "Jestem z Wietnamu." },
        { "speaker": "A", "vi": "Em bao nhiêu tuổi?", "pl": "Ile masz lat?" },
        { "speaker": "B", "vi": "Em 20 tuổi. Còn anh?", "pl": "Mam 20 lat. A ty?" },
        { "speaker": "A", "vi": "Anh 22 tuổi. Số điện thoại của em là bao nhiêu?", "pl": "Mam 22 lata. Jaki jest twój numer telefonu?" },
        { "speaker": "B", "vi": "Số điện thoại của em là 489 003 625 – bốn tám chín không không ba sáu hai năm.", "pl": "Mój numer to 489 003 625." },
        { "speaker": "A", "vi": "Cảm ơn, chào em!", "pl": "Dziękuję, cześć!" }
      ]
    }
  ],
