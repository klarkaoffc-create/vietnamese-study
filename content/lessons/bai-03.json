  "grammar": [
    {
      "id": "g-bai-03-nationality",
      "title": "Pytanie o narodowość",
      "pattern": "Zaimek + là người nước nào? → Zaimek + là người + nazwa kraju",
      "explanation": "„người” + nazwa kraju = osoba tej narodowości. Przeczenie: „không phải là người…”. Pytanie rozstrzygające: dodaj „không?” na końcu (zob. Bài 2).",
      "examples": [
        { "vi": "Mình là người Việt Nam.", "pl": "Jestem Wietnamczykiem." },
        { "vi": "Anh ấy không phải là người Mỹ.", "pl": "On nie jest Amerykaninem." },
        { "vi": "Em là người Ba Lan không?", "pl": "Czy jesteś z Polski?", "status": "flagged", "note": "Zob. CONTENT_REVIEW: podręcznikowa forma „Em có phải là người Ba Lan không?”" }
      ],
      "keywords": ["người", "nước nào", "narodowość", "anh ấy"],
      "practice": ["e-bai-03-typed-nationality", "e-bai-03-fill-country", "e-bai-03-open-nationality"]
    },
    {
      "id": "g-bai-03-numbers",
      "title": "Liczby 0–1000",
      "pattern": "11–19: mười + cyfra · 20–90: cyfra + mươi · 21–99: cyfra + mươi + cyfra · 100: một trăm · 1000: một nghìn",
      "explanation": "Cyfra 5 w pozycji jedności w liczbach od 15 wzwyż brzmi „lăm” (mười lăm, hai mươi lăm). Dziesiątki od 20 tworzy się przez „mươi” (bez tonu): hai mươi, ba mươi. W materiale nauczycielki 21 = „hai mươi một” (zob. CONTENT_REVIEW: w standardzie także „hai mươi mốt”).",
      "examples": [
        { "vi": "mười một", "pl": "11" },
        { "vi": "hai mươi", "pl": "20" },
        { "vi": "ba mươi bảy", "pl": "37" },
        { "vi": "năm mươi tám", "pl": "58" },
        { "vi": "một trăm", "pl": "100" },
        { "vi": "một nghìn", "pl": "1000" }
      ],
      "keywords": ["liczby", "mười", "mươi", "lăm", "trăm", "nghìn"],
      "practice": ["e-bai-03-number-gen", "e-bai-03-number-mcq"]
    },
    {
      "id": "g-bai-03-age",
      "title": "Pytanie o wiek",
      "pattern": "Zaimek + bao nhiêu tuổi? → Zaimek + liczba + tuổi.",
      "explanation": "„bao nhiêu” = ile; „tuổi” = lat (używane tylko dla wieku). Nie ma tu czasownika „mieć”.",
      "examples": [
        { "vi": "Cô bao nhiêu tuổi?", "pl": "Ile pani ma lat?" },
        { "vi": "Mình 36 tuổi.", "pl": "Mam 36 lat." }
      ],
      "keywords": ["wiek", "tuổi", "bao nhiêu"],
      "practice": ["e-bai-03-age-gen", "e-bai-03-open-age"]
    },
    {
      "id": "g-bai-03-phone",
      "title": "Numer telefonu i partykuła của",
      "pattern": "Số điện thoại + của + zaimek + là bao nhiêu? → Số điện thoại của mình là …",
      "explanation": "„của” wyraża posiadanie: „số điện thoại của anh” = twój numer telefonu. Numer czyta się cyfra po cyfrze (0 = không).",
      "examples": [
        { "vi": "Số điện thoại của anh là bao nhiêu?", "pl": "Jaki jest twój numer telefonu?" },
        { "vi": "Số điện thoại của anh là 523 911 487 – năm hai ba chín một một bốn tám bảy.", "pl": "Mój numer to 523 911 487." }
      ],
      "keywords": ["của", "telefon", "số điện thoại"],
      "practice": ["e-bai-03-phone-gen", "e-bai-03-order-phone"]
    },
    {
      "id": "g-bai-03-con-co",
      "title": "„Còn em?” i czasownik có",
      "pattern": "Zdanie. Còn + zaimek? · Zaimek + có + rzeczownik + không?",
      "explanation": "„Còn + zaimek?” = „a ty?” – odbija pytanie na rozmówcę. „có” = mieć; pytanie „Bạn có Zalo không?”, odpowiedź przecząca „Mình không có Zalo”.",
      "examples": [
        { "vi": "Anh là người Mỹ. Còn em?", "pl": "Jestem Amerykaninem. A ty?" },
        { "vi": "Bạn có Zalo không?", "pl": "Masz Zalo?" },
        { "vi": "Mình không có Zalo, có Facebook.", "pl": "Nie mam Zalo, mam Facebooka." }
      ],
      "keywords": ["còn", "có", "mieć"],
      "practice": ["e-bai-03-dialogue-2", "e-bai-03-fill-con"]
    }
  ],
  "dialogues": [
    {
      "id": "d-bai-03-intro",
      "title": "Skąd jesteś? Ile masz lat?",
      "situation": "Starszy mężczyzna (anh) rozmawia z młodszą osobą (em).",
      "lines": [
