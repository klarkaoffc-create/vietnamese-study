  "grammar": [
    {
      "id": "g-bai-01-pronouns",
      "title": "Zaimki osobowe zależne od wieku",
      "pattern": "Rozmówca młodszy → em · rówieśnik → bạn · trochę starszy → anh / chị · 30–40 → chú / cô · 40–60 → bác · 60+ → ông / bà",
      "explanation": "W wietnamskim nie ma jednego słowa „ty”. Zaimek zależy od wieku i płci rozmówcy względem nas. Ten sam zaimek działa też jako „on/ona” po dodaniu „ấy” (anh ấy, chị ấy – zob. Bài 3).\n\n„Ja” to mình (mniej formalnie, między rówieśnikami) albo tôi (formalnie). W dialogach z lekcji osoba młodsza mówi o sobie „em”, a starsza „anh/chị” – zaimek „ja” dopasowuje się do relacji.",
      "examples": [
        { "vi": "Chào em!", "pl": "Cześć! (do osoby młodszej)" },
        { "vi": "Chào bác!", "pl": "Dzień dobry! (do osoby w wieku 40–60)" },
        { "vi": "Chào ông!", "pl": "Dzień dobry panu! (60+)" }
      ],
      "keywords": ["zaimki", "anh", "chị", "em", "bạn", "tôi", "mình"],
      "practice": ["e-bai-01-pronoun-gen", "e-bai-01-pronoun-match", "e-bai-01-pronoun-mcq"]
    },
    {
      "id": "g-bai-01-greetings",
      "title": "Przywitania i pożegnania",
      "pattern": "Xin chào! · Chào + zaimek · Chào + imię",
      "explanation": "„Xin chào” jest uniwersalne i uprzejme. Na co dzień mówi się „Chào” + zaimek dopasowany do rozmówcy (Chào anh!, Chào cô!) albo „Chào” + imię. Tej samej formy używa się przy pożegnaniu.",
      "examples": [
        { "vi": "Xin chào!", "pl": "Dzień dobry!" },
        { "vi": "Chào chị!", "pl": "Dzień dobry! (do trochę starszej kobiety)" },
        { "vi": "Chào Anna!", "pl": "Cześć, Anno!" }
      ],
      "keywords": ["chào", "powitanie", "pożegnanie"],
      "practice": ["e-bai-01-greet-typed", "e-bai-01-diacritics"]
    }
  ],
  "pronunciation": [
    {
      "id": "p-bai-01-north-south",
      "title": "Północ a południe",
      "body": "Materiał nauczycielki podaje wymowę północną (Hanoi) i południową (Sajgon). Najważniejsze różnice: „d” = północ „z” / południe „j”; „gi” = północ „zi” / południe „ji”; „r” = północ „z” / południe „r”; „s” = północ „s” / południe „sz”; „tr” = północ „ć” / południe „tr”. Pozostałe głoski brzmią tak samo w obu odmianach."
    },
    {
      "id": "p-bai-01-tones",
      "title": "Sześć tonów",
      "body": "Ton zapisuje się znakiem nad lub pod samogłoską: a (ngang – równy, bez znaku), à (huyền – opadający), ả (hỏi – „pytający”), ã (ngã – łamany), á (sắc – wznoszący), ạ (nặng – ciężki, krótki). Zmiana tonu zmienia znaczenie słowa, dlatego znak tonu jest częścią pisowni, a nie ozdobą."
    }
  ],
