  "grammar": [
    {
      "id": "g-bai-10-the-nao",
      "title": "Pytanie „jaki?” – thế nào?",
      "pattern": "rzeczownik + thế nào?",
      "explanation": "„thế nào” stoi na końcu, po rzeczowniku, o który pytamy.",
      "examples": [
        { "vi": "Con chó thế nào?", "pl": "Jaki jest ten pies?" },
        { "vi": "Cái nhà này thế nào?", "pl": "Jaki jest ten dom?" },
        { "vi": "Chị ấy thế nào?", "pl": "Jaka ona jest?" }
      ],
      "keywords": ["thế nào", "jaki"],
      "practice": ["e-bai-10-typed-the-nao"]
    },
    {
      "id": "g-bai-10-adj-sentence",
      "title": "Rzeczownik + przymiotnik i przeczenie",
      "pattern": "rzeczownik + przymiotnik · rzeczownik + không + przymiotnik",
      "explanation": "Przymiotnik pełni rolę orzeczenia – nie potrzeba „là”: „Nhà cao” = dom jest wysoki. Przeczenie: „không” przed przymiotnikiem. Wskazanie „này” (ten) / „kia” (tamten) stoi po rzeczowniku: „Ly bia này” – ta szklanka piwa.",
      "examples": [
        { "vi": "Nhà cao.", "pl": "Dom jest wysoki." },
        { "vi": "Cô ấy vui.", "pl": "Ona jest szczęśliwa." },
        { "vi": "Quyển sách mới.", "pl": "Książka jest nowa." },
        { "vi": "Ly bia này không to.", "pl": "Ta szklanka piwa nie jest duża." },
        { "vi": "Con mèo kia không nhỏ.", "pl": "Tamten kot nie jest mały." },
        { "vi": "Phim này không hay.", "pl": "Ten film nie jest ciekawy." }
      ],
      "keywords": ["przymiotnik", "không", "này", "kia"],
      "practice": ["e-bai-10-typed-neg", "e-bai-10-error-la", "e-bai-10-adj-match"]
    },
    {
      "id": "g-bai-10-rat-qua-lam",
      "title": "Bardzo: rất, quá, lắm",
      "pattern": "rất + przymiotnik / czasownik · przymiotnik + quá / lắm · không + przymiotnik + lắm / quá (niezbyt)",
      "explanation": "„rất” stoi PRZED przymiotnikiem lub czasownikiem: „rất nhiều”, „rất thích”. „quá” i „lắm” stoją PO przymiotniku: „đẹp quá”, „cao lắm”. Przy negatywnych przymiotnikach „quá / lắm” mogą oznaczać „zbyt” albo zawołanie: „đắt quá!” – ale drogie! „không + przymiotnik + lắm” = niezbyt: „không đẹp lắm”. Lekcja podaje też „không đẹp quá” (CONTENT_REVIEW).",
      "examples": [
        { "vi": "Ở đây có rất nhiều người.", "pl": "Tu jest bardzo dużo ludzi." },
        { "vi": "Tôi rất thích ăn bánh mì.", "pl": "Bardzo lubię jeść bánh mì." },
        { "vi": "Chị ấy đẹp quá.", "pl": "Ona jest bardzo ładna." },
        { "vi": "Anh ấy cao lắm.", "pl": "On jest bardzo wysoki." },
        { "vi": "Cái này đắt quá!", "pl": "Ale drogie! / Zbyt drogie!" },
        { "vi": "Không đẹp lắm.", "pl": "Niezbyt ładny." }
      ],
      "keywords": ["rất", "quá", "lắm", "bardzo", "zbyt", "niezbyt"],
      "practice": ["e-bai-10-mcq-rat", "e-bai-10-fill-lam", "e-bai-10-error-rat"]
    },
    {
      "id": "g-bai-10-comparison",
      "title": "Stopniowanie: bằng, như, hơn, nhất",
      "pattern": "A + przymiotnik + bằng + B · A + czasownik + przymiotnik + như + B · A + przymiotnik + hơn + B · rzeczownik + przymiotnik + nhất",
      "explanation": "„bằng” = tak samo (równy): „Tôi cao bằng anh”. „như” (lub potocznie „kiểu”) = tak jak: „Chị ấy nói nhanh như anh”. „hơn” = bardziej niż: „Tiếng Việt khó hơn tiếng Ba Lan”. „nhất” = najbardziej: „Cái nhà này to nhất”. Z czasownikiem „thích” „nhất” może stać na końcu albo przed dopełnieniem: „Mình thích sách này nhất” / „Mình thích nhất sách này”.",
      "examples": [
        { "vi": "Tôi cao bằng anh.", "pl": "Jestem tak samo wysoki jak ty." },
        { "vi": "Chị ấy nói nhanh như anh.", "pl": "Ona mówi tak szybko jak ty." },
        { "vi": "Tiếng Việt khó hơn tiếng Ba Lan.", "pl": "Wietnamski jest trudniejszy niż polski." },
        { "vi": "Cái nhà này to nhất.", "pl": "Ten dom jest największy." },
        { "vi": "Mình thích sách này nhất.", "pl": "Najbardziej lubię tę książkę." }
      ],
      "keywords": ["bằng", "như", "hơn", "nhất", "porównanie", "stopniowanie"],
      "practice": ["e-bai-10-comparison-gen", "e-bai-10-order-hon", "e-bai-10-typed-nhat"]
    }
  ],
